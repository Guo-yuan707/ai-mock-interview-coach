# 虚拟环境 — 每个机器自己装，不用上传
.venv/

# 密钥文件 — 包含 API Key，绝不能泄露
.env

# Python 缓存 — 自动生成，没用
__pycache__/
*.pyc

# pytest 缓存 — 跑测试自动生成，没用
.pytest_cache/
**/.pytest_cache/

# 导出文件 — 程序生成的结果，没必要上传
output/

# 本地数据库 — 一场场面试的落库，程序生成，没必要上传
data/

# 真实个人资料 — 含简历/JD/联系方式，绝不进公开仓库
# (规则:凡含个人隐私的输入文本，放这里并以 my- 开头，靠这行兜底)
my-*.txt
